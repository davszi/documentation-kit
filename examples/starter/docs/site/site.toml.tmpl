title = "{{project_title}}"
gh_repo = "{{repository_url}}"
gh_ref = "main"
chapter_reader = true
# Every tracked Markdown file of the project becomes a page, listed in the
# sidebar's Reference section, unless it starts with +++ frontmatter or lies in
# the kit submodule. A private repository with a public site publishes those
# files too: exclude what must stay private, or set
# `reference_listing = false` to list only [[source_pages]] tables.
# CLAUDE.md only points agents at AGENTS.md.
# reference_listing = false
reference_exclude = ["CLAUDE.md"]
# Every project sets tooling_roots; [] states that it has no tooling yet.
# Once it names a folder, such as ["tools/"], every tracked file or folder
# directly under it needs a row in docs/CAPABILITY_MAP.md, and lint checks its
# generated Imported by column. capability_map names the map when it lives
# elsewhere; a tool that imports from a folder under experiment_roots warns.
tooling_roots = []
# capability_map = "docs/CAPABILITY_MAP.md"
# experiment_roots = ["experiments/"]
# Lint compiles every formula on the built pages with the kit's KaTeX, which
# runs in Node.js. Without Node it prints a note and skips the check. With
# this setting lint fails without Node, so a hosted check cannot skip it.
# formula_check_required = true

[[nav]]
label = "Home"
file = "index.html"

[[nav]]
label = "Guide"
file = "guide.html"
group = "guide"
